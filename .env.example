# ── 資料庫 ────────────────────────────────────────────
# Postgres 連線字串(Vercel Storage → Postgres 免費方案即可):
# DATABASE_URL = POSTGRES_PRISMA_URL 的值(連線池,平常跑站用)
# DIRECT_URL   = POSTGRES_URL_NON_POOLING 的值(直連,只有 prisma migrate 會用)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# 部署後的完整網址(share API 組 QR 取圖連結用)
APP_BASE_URL="http://localhost:3000"

# ── 舊塔羅站(site-static/tarot)的 Gemini,LIFF 版穩定後退場 ──
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# ── LINE OA v1 ────────────────────────────────────────
# 生成模型供應商:claude(正式建議)| kimi(測試/備援)
MODEL_PROVIDER="claude"
# Claude API 金鑰(console.anthropic.com);留空則解讀走本地降級文案
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_FREE="claude-haiku-4-5"
ANTHROPIC_MODEL_PAID="claude-sonnet-5"
# Kimi/Moonshot(platform.moonshot.ai):MODEL_PROVIDER=kimi 時使用
# KIMI_MODEL 填你帳號實際可用的模型 ID(例 K2.6 系列;kimi-latest 為最新別名)
KIMI_API_KEY=""
KIMI_MODEL="kimi-latest"
KIMI_BASE_URL="https://api.moonshot.ai/v1"
# 深度占卜定價(TWD)
PRICE_DEEP="149"
# LINE Login channel ID(LIFF token 驗證);開發時 LINE_STUB=1 可用 "stub:<userId>" 當 token
LINE_CHANNEL_ID=""
LINE_STUB="0"
