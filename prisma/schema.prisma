// 塔羅站唯一還在用的資料表:現場占卜結果圖的暫存(24 小時後過期)。
// 課程平台時期的舊表已從 schema 移除,但沒有下 DROP——migrations/ 保留
// 完整歷史,migrate deploy 只補未套用的部分,不會動到既有資料。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 現場占卜:desk 版存結果圖 → 回傳 QR → 客人掃走。只留 24 小時。
model TarotShare {
  id        String   @id @default(cuid())
  token     String   @unique
  image     Bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ── LINE OA v1(規格 §7)────────────────────────────────

// LIFF 進站的客人,以 LINE userId 為身分。額度與 streak 都掛在這裡。
model TarotUser {
  id            String    @id @default(cuid())
  lineUserId    String    @unique
  displayName   String?
  birthday      DateTime?
  deepenCredits Int       @default(0) // 加深解讀額度(streak 連七獎勵也發這個)
  streak        Int       @default(0)
  lastDailyDate String? // YYYY-MM-DD(台北時區),日抽換日與斷簽判定用
  createdAt     DateTime  @default(now())

  readings   Reading[]
  purchases  Purchase[]
  dailyDraws DailyDraw[]
  cardsSeen  CardSeen[]
}

// 一次占卜:抽牌當下建立(status=drawn),生成後補文本。
// 牌面與 tier 在抽牌時就定死——同一副牌永遠同一個方向。
model Reading {
  id        String    @id @default(cuid())
  userId    String
  user      TarotUser @relation(fields: [userId], references: [id])
  level     String // daily | deepen | deep
  spreadId  String
  topic     String?
  question  String?
  cardsJson String // Drawn[] 序列化
  tier      String // T1..T5
  seedNonce String // 伺服器 nonce,同筆占卜可回溯重算
  status    String    @default("drawn") // drawn | generated | fallback
  text      String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// LINE Pay 訂單。providerTxId 唯一 → webhook 重送天然冪等。
model Purchase {
  id           String    @id @default(cuid())
  userId       String
  user         TarotUser @relation(fields: [userId], references: [id])
  kind         String // deepen | deep
  amount       Int // TWD
  provider     String // linepay | mock
  providerTxId String?   @unique
  status       String    @default("pending") // pending | paid | failed | refunded
  readingId    String?
  createdAt    DateTime  @default(now())
  paidAt       DateTime?

  @@index([userId, createdAt])
}

// 免費日抽:一人一天一筆(台北時區)。
model DailyDraw {
  id        String    @id @default(cuid())
  userId    String
  user      TarotUser @relation(fields: [userId], references: [id])
  date      String // YYYY-MM-DD(台北)
  readingId String
  createdAt DateTime  @default(now())

  @@unique([userId, date])
}

// 78 張牌收集圖鑑:第一次抽到才寫入。
model CardSeen {
  id          String    @id @default(cuid())
  userId      String
  user        TarotUser @relation(fields: [userId], references: [id])
  cardN       Int
  firstSeenAt DateTime  @default(now())

  @@unique([userId, cardN])
}

// 使用狀況統計(2026-08-23)。
//
// 刻意設計成「結構上就追不回是誰」——店主的指示是「不要記是誰問的」:
//   ✗ 不存 IP、不存 User-Agent、不存 cookie 或任何 session 識別碼
//   ✗ 不存客人打的問題內容(那是最敏感的東西:外遇、生病、錢)
//   ✗ 不給每次造訪編號——漏斗用「各步驟的次數比」算,不是追同一個人走完幾步
//   ✓ 只存:什麼時候、走到哪一步、選了哪個分類
//
// 這樣就算整張表外洩,也拼不出任何一位客人是誰、問過什麼。
model TarotEvent {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  kind     String // 白名單見 lib/tarot/events.ts
  topic    String? // love | career | money
  scenario String? // 處境的標題文字(固定選項,不是客人自由輸入)
  tier     String? // T1..T5
  wide     Boolean? // true=寬螢幕(店面) false=窄螢幕(手機)
  detail   String? // 每個 kind 自己的小標籤,例:confirm 的 yes / no

  // 2026-08-23 店主追加的兩個欄位。跟上面那些不同,這兩個要小心看待:
  //
  // question —— 客人手動打的問題原文。店主要知道大家到底在問什麼。
  //   這是這張表裡唯一「有可能認得出人」的東西(有人會寫「我跟阿明」
  //   「我在 XX 公司」),所以:只有 /admin 進得去、資料庫層開 RLS、
  //   而且 90 天自動刪除(見 lib/tarot/events.ts 的 sweep())。
  //
  // visitor —— 瀏覽器本機產生的隨機字串,用來看「有沒有回來算第二次」。
  //   它不是身分:不含姓名、裝置資訊或任何可推導的東西,清瀏覽器資料就換一個,
  //   換一台裝置也是新的。它能回答「有多少人算過不只一次」,
  //   回答不了「這個人是誰」。
  question String?
  visitor  String?

  @@index([at])
  @@index([kind, at])
  @@index([visitor])
}
