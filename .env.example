# ── 資料庫 ────────────────────────────────────────────
# Postgres 連線字串(Vercel Storage → Postgres 免費方案即可):
# DATABASE_URL = POSTGRES_PRISMA_URL 的值(連線池,平常跑站用)
# DIRECT_URL   = POSTGRES_URL_NON_POOLING 的值(直連,只有 prisma migrate 會用)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# 部署後的完整網址(share API 組 QR 取圖連結用)
APP_BASE_URL="http://localhost:3000"

# ── AI 塔羅占卜 ────────────────────────────────────────
# Google AI Studio → Create API key(https://aistudio.google.com/apikey)
# 留空則 /api/tarot/reading 回傳 503,前端會退回本地簡版解讀
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
