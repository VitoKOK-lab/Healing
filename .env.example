# ── 基本 ──────────────────────────────────────────────
# Postgres 連線字串。用 Vercel Storage → Postgres(免費方案)時,
# Connect Project 後會自動注入 POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING,
# 把這兩個值分別複製貼成下面這兩個名字即可(部署見 DEPLOY.md 第 2 步):
# DATABASE_URL = POSTGRES_PRISMA_URL 的值(連線池,平常跑站用)
# DIRECT_URL   = POSTGRES_URL_NON_POOLING 的值(直連,只有 prisma migrate 會用)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
# 部署後的完整網址(組 webhook / 跳轉絕對路徑用)
APP_BASE_URL="http://localhost:3000"

# ── Auth.js ───────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="請換成隨機字串"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# 示範登入(免金鑰,輸入名稱即可體驗全站):"true"=開放(預設)|"false"=正式上線前關閉
DEMO_LOGIN="true"
# Google Cloud Console → OAuth 2.0 用戶端(選填;不填則登入頁只顯示示範登入)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# LINE Developers → LINE Login channel(選填;需申請 email 權限才拿得到使用者 email)
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""
# 管理員 email 白名單(逗號分隔)。示範登入時把此 email 填進登入表單的 Email 欄位即可測試後台。
ADMIN_EMAILS=""

# ── 金流(綠界)─────────────────────────────────────────
# mock = 模擬綠界(開發用,免金鑰) | ecpay = 真綠界
PAYMENT_PROVIDER="mock"
# 真綠界時填入(測試環境值見綠界技術文件)
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
# 測試: https://payment-stage.ecpay.com.tw  正式: https://payment.ecpay.com.tw
ECPAY_BASE_URL="https://payment-stage.ecpay.com.tw"

# ── 影片(Cloudflare Stream)─────────────────────────────
# mock = 本機範例影片(開發用) | cloudflare = Cloudflare Stream
VIDEO_PROVIDER="mock"
CF_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""
CF_STREAM_SIGNING_KEY_ID=""
CF_STREAM_SIGNING_KEY_PEM=""
CF_STREAM_CUSTOMER_CODE=""

# ── AI 塔羅占卜(靜態站 tarot.html 呼叫)──────────────────
# Google AI Studio → Create API key(https://aistudio.google.com/apikey)
# 留空則 /api/tarot/reading 回傳 503,前端會顯示「AI 解讀暫時無法使用」
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
