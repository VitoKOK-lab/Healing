# ── 基本 ──────────────────────────────────────────────
# Postgres 連線字串(Neon 免費方案即可;Vercel + Neon 整合會自動注入)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# 部署後的完整網址(組 webhook / 跳轉絕對路徑用)
APP_BASE_URL="http://localhost:3000"

# ── Auth.js ───────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="請換成隨機字串"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Google Cloud Console → OAuth 2.0 用戶端
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# LINE Developers → LINE Login channel(需申請 email 權限才拿得到使用者 email)
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""
# 管理員 email 白名單(逗號分隔;管理員請用 Google 登入)
ADMIN_EMAILS=""

# ── 金流(綠界)─────────────────────────────────────────
# mock = 模擬綠界(開發用,免金鑰) | ecpay = 真綠界
PAYMENT_PROVIDER="mock"
# 真綠界時填入(測試環境值見綠界技術文件)
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
# 測試: https://payment-stage.ecpay.com.tw  正式: https://payment.ecpay.com.tw
ECPAY_BASE_URL="https://payment-stage.ecpay.com.tw"

# ── 影片(Cloudflare Stream)─────────────────────────────
# mock = 本機範例影片(開發用) | cloudflare = Cloudflare Stream
VIDEO_PROVIDER="mock"
CF_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""
CF_STREAM_SIGNING_KEY_ID=""
CF_STREAM_SIGNING_KEY_PEM=""
CF_STREAM_CUSTOMER_CODE=""
