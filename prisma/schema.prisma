// 塔羅站唯一還在用的資料表:現場占卜結果圖的暫存(24 小時後過期)。
// 課程平台時期的舊表已從 schema 移除,但沒有下 DROP——migrations/ 保留
// 完整歷史,migrate deploy 只補未套用的部分,不會動到既有資料。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 現場占卜:desk 版存結果圖 → 回傳 QR → 客人掃走。只留 24 小時。
model TarotShare {
  id        String   @id @default(cuid())
  token     String   @unique
  image     Bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
